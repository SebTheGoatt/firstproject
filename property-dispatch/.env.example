# ---- Storage --------------------------------------------------------
DATA_BACKEND=supabase              # or "memory" for a local demo (no database)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=         # Supabase → Settings → API Keys → secret key sb_secret_… (server only!)

# ---- Business base: Spring, TX --------------------------------------
BUSINESS_TIMEZONE=America/Chicago
BASE_LAT=30.0799
BASE_LNG=-95.4172
# END_LAT=                         # optional; defaults to the base
# END_LNG=
CREW_START_TIME=08:00

# ---- Runway quota & freeze ------------------------------------------
FREEZE_HOUR=20                     # 8 PM local
DAILY_JOB_QUOTA=25
BOOKING_HORIZON_DAYS=60

# ---- Routing --------------------------------------------------------
OSRM_URL=https://router.project-osrm.org
OPTIMIZE_FOR=duration              # duration | distance
SOLVER_TIME_LIMIT_S=10

# ---- Geocoding ------------------------------------------------------
# Nominatim requires a real contact; example.com is rejected.
GEOCODER_USER_AGENT=property-dispatch/1.0 (you@yourbusiness.com)
# Optional Google address dropdown (Places API (New)). A *browser* key restricted to your site.
GOOGLE_MAPS_BROWSER_KEY=

# ---- Twilio (leave blank to log messages instead of sending) --------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+12815550000
BUSINESS_NAME=Semper Green Lawn Care

# ---- Card payments: Stripe (leave blank to take cash only) ------------
STRIPE_SECRET_KEY=                 # Stripe Dashboard → Developers → API keys → Secret key (sk_live_… / sk_test_…)
STRIPE_WEBHOOK_SECRET=             # Stripe → Developers → Webhooks → your endpoint → Signing secret (whsec_…)
PUBLIC_BASE_URL=                   # e.g. https://property-dispatch-xxxx.onrender.com (used in texted pay links)

# ---- Secrets (generate with: python -c "import secrets;print(secrets.token_urlsafe(24))")
CREW_ACCESS_TOKEN=
WEBHOOK_SECRET=
CRON_SECRET=

# Dispatch assistant (optional). Leave OLLAMA_BASE_URL blank to turn it off.
# OLLAMA_BASE_URL=https://ollama.com/v1
# OLLAMA_MODEL=gemma4:31b
# OLLAMA_API_KEY=            # set this in Render, never commit it
# OLLAMA_BASIC_AUTH=        # user:password if you reach your own computer through a protected tunnel
