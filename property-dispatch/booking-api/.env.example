PORT=3001

# Geocoding: set MAPBOX_ACCESS_TOKEN to use Mapbox; otherwise free Nominatim is used
# and GEOCODER_USER_AGENT must include a real contact email.
MAPBOX_ACCESS_TOKEN=
GEOCODER_USER_AGENT=booking-api/1.0 (you@yourbusiness.com)

# Supabase → Project Settings → API (service_role key is server-only!)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
