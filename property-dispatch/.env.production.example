# ==============================================================================
# SEMPER GREEN LAWN CARE - PRODUCTION ENVIRONMENT MATRIX
# Copy each line into Render → property-dispatch → Environment (and the nightly cron
# job where marked). NEVER commit real values to this public repo.
# The go-live checklist at /owner/readiness shows which ones are still missing.
# ==============================================================================

# Core System Framework
ENVIRONMENT=production
DEBUG=false
SECRET_KEY=                       # optional; generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
DATA_BACKEND=supabase
PUBLIC_BASE_URL=https://property-dispatch.onrender.com   # or your own domain once it points here
CREW_ACCESS_TOKEN=                # owner sign-in; 24+ random characters (Render can generate it)
WEBHOOK_SECRET=                   # 24+ random characters
CRON_SECRET=                      # 24+ random characters

# Stripe Live Financial Pipeline (Stripe → Developers → API keys / Webhooks)
STRIPE_PUBLISHABLE_KEY=pk_live_…  # optional: checkout runs on Stripe's own page
STRIPE_SECRET_KEY=sk_live_…
STRIPE_WEBHOOK_SECRET=whsec_…     # endpoint: <PUBLIC_BASE_URL>/webhooks/stripe
                                  # events: checkout.session.completed, checkout.session.async_payment_succeeded,
                                  #         payment_intent.succeeded

# Communication Layer & SMS Engine (Twilio, number registered for A2P 10DLC)
TWILIO_ACCOUNT_SID=AC…
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+1936…        # same as TWILIO_FROM_NUMBER

# Transactional Communication Fallback (nightly manifest backup by email; web service AND cron job)
RESEND_API_KEY=re_…
OPERATIONAL_ALERT_EMAIL=ops@sempergreenlawn.com
RESEND_FROM=Semper Green Dispatch <dispatch@sempergreenlawn.com>   # after verifying the domain in Resend

# Business details shown on the site
BUSINESS_EMAIL=                   # your business Gmail
BUSINESS_PHONE=                   # optional; a business line (e.g. Google Voice), never a personal cell. Blank = not shown
GOOGLE_REVIEW_URL=                # Google Business Profile → Ask for reviews

# Telemetry & Spatial Mapping Anchor (web service AND cron job)
GOOGLE_MAPS_API_KEY=AIzaSy…       # browser key restricted to your site
BASE_YARD_LATITUDE=30.010200      # where the crew leaves from each morning (never shown publicly)
BASE_YARD_LONGITUDE=-95.420100

# Database Persistence (web service AND cron job)
SUPABASE_URL=https://<your-project>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Push notifications (make the pair at /push-setup)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
