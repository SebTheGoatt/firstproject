      "id": "youtube-thumbnail",
      "name": "YouTube Thumbnail",
      "category": "create",
      "needsPhoto": false,
      "description": "Bold 16:9 thumbnail with your headline in big readable letters.",
      "fields": [
        {
          "id": "subject",
