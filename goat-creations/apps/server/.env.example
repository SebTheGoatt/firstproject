# Copy to .env and fill in. .env is git-ignored: never commit real keys.
PORT=8787

# --- Generation (MuAPI) ---
MUAPI_API_KEY=
AI_BACKEND_URL=https://api.muapi.ai
SEBASTINA_IMAGE_MODEL=flux-dev-image
SEBASTINA_VIDEO_MODEL=seedance-lite-t2v
# Models customers may pick (comma-separated). Default: just the two above.
# Others cost you more per generation at MuAPI, while customers pay the same credit.
SEBASTINA_SERVER_MODELS=

# --- App access tokens ---
# A long random secret (at least 32 characters), e.g. from: openssl rand -base64 48
# Then issue a token per customer: npm run token -- <lago-customer-id>
SEBASTINA_TOKEN_SECRET=

# --- Billing (Lago) ---
SEBASTINA_BILLING=on
LAGO_API_KEY=
LAGO_API_URL=https://api.getlago.com/api/v1
CREDITS_PER_IMAGE=1
CREDITS_PER_VIDEO=1

# --- AI-crawler paywall (x402) ---
# Your wallet address that receives the fees. Empty = AI crawlers are refused (403).
PAYWALL_PAY_TO=
# base-sepolia = test USDC (start here); base = real USDC (needs a mainnet facilitator).
PAYWALL_NETWORK=base-sepolia
PAYWALL_PRICE_USDC=0.001
# Empty = the public test facilitator (https://x402.org/facilitator).
PAYWALL_FACILITATOR_URL=
# Your public address, used in the payment "resource" URL, e.g. https://goatcreations.app
PUBLIC_ORIGIN=
