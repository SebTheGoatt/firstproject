# Copy this file to .env and fill it in. .env is git-ignored: never commit real keys.

# --- Generation backend (MuAPI, as used by Open-Generative-AI) ---
# Key from https://muapi.ai (dashboard > API keys).
MUAPI_API_KEY=
AI_BACKEND_URL=https://api.muapi.ai
# Model endpoints (any MuAPI model ID). Defaults: FLUX.1 Dev and Seedance 1.0 Lite.
SEBASTINA_IMAGE_MODEL=flux-dev-image
SEBASTINA_VIDEO_MODEL=seedance-lite-t2v

# --- Billing (Lago) ---
# on = every generation needs an active subscription and wallet credits.
# off = free, for local testing only.
SEBASTINA_BILLING=on
LAGO_API_KEY=
# Lago Cloud by default. Self-hosted: http://localhost:3000/api/v1
LAGO_API_URL=https://api.getlago.com/api/v1
# The customer's external ID in Lago (asked at start if empty).
SEBASTINA_CUSTOMER_ID=
CREDITS_PER_IMAGE=1
CREDITS_PER_VIDEO=1
